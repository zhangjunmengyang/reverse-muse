# ===========================================
# Reverse Muse Configuration
# ===========================================

# LLM Provider (required)
OPENAI_API_KEY=your-openai-api-key

# Optional: Custom API endpoint (for proxies or compatible APIs)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Model selection (defaults shown)
# DEFAULT_LLM_MODEL=gpt-4o-mini
# DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# Optional: configure LLM and embeddings separately for OpenAI-compatible providers.
# LLM_API_KEY=your-llm-token
# LLM_BASE_URL=https://maas.devops.xiaohongshu.com/v1
# DEFAULT_LLM_MODEL=kimi-k2.6
# LLM_MAX_TOKENS=4096
# MAAS_USER_EMAIL=your-email@example.com
# MAAS_APP_ID=qs-api

# EMBEDDING_API_KEY=your-embedding-token
# EMBEDDING_BASE_URL=https://maas.devops.xiaohongshu.com/v1
# DEFAULT_EMBEDDING_MODEL=qwen3-embedding-8b
# EMBEDDING_DIMENSION=4096
# EMBEDDING_ENCODING_FORMAT=float
